# URL API backend untuk build produksi.
# Di-bake ke bundle saat `vite build` (mode production), bukan saat runtime.
# Tulis origin saja: tanpa "/api" dan tanpa trailing slash.
# Kode sudah menambahkan prefix "/api/v1/..." pada setiap request.
VITE_API_URL=https://backend-aedo-hotel.ethiodeploy.app
